# Développement local uniquement. Ne jamais committer .env.
WEB_PORT=8080
API_PORT=8000
COOKIE_SECURE=false
# Activer explicitement pour créer des comptes du pilote local.
ALLOW_REGISTRATION=false
API_KEY=

# Profil telemetry : choisir des valeurs uniques avant le premier démarrage.
INFLUX_URL=http://influxdb:8086
INFLUX_INIT_USERNAME=ecotwin
INFLUX_INIT_PASSWORD=
INFLUX_INIT_ORG=EcoTwin
INFLUX_INIT_BUCKET=air_quality
INFLUX_INIT_ADMIN_TOKEN=
INFLUX_PORT=8086

# Profil monitoring, facultatif
GRAFANA_PORT=3005
GRAFANA_ADMIN_PASSWORD=
