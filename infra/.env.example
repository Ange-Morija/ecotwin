# Développement local uniquement. Ne jamais committer .env.
WEB_PORT=8080
API_PORT=8000
COOKIE_SECURE=false
# Activer explicitement pour créer des comptes du pilote local.
ALLOW_REGISTRATION=false
API_KEY=

# Profil telemetry : choisir des valeurs uniques avant le premier démarrage.
INFLUX_URL=http://influxdb:8086
INFLUX_INIT_USERNAME=ecotwin
INFLUX_INIT_PASSWORD=
INFLUX_INIT_ORG=EcoTwin
INFLUX_INIT_BUCKET=air_quality
INFLUX_INIT_ADMIN_TOKEN=
INFLUX_PORT=8086

# Profil monitoring, facultatif
GRAFANA_PORT=3005
GRAFANA_ADMIN_PASSWORD=

# URL publique canonique, aucun chemin ni paramètre; HTTPS en production.
APP_URL=http://localhost:8080
# Facultatif : assistant OpenAI. Renseigner via un gestionnaire de secrets.
ECOTWIN_OPENAI_API_KEY=
OPENAI_MODEL=
# Facultatif : abonnement Business, prix récurrent créé dans votre compte Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_MODE=test
# Ne passer à true qu’après validation de votre offre et des parcours sandbox.
STRIPE_ALLOW_LIVE=false
